library ieee;
use ieee.std_logic_1164.all; 
use ieee.numeric_std.all;
--use work.my_package;

--package my_package is 
	--constant d : integer;
	
--end package my_package;

entity bit_adder is 
	port(
		A: in std_ulogic;
		B: in std_ulogic_vector(3 downto 0);
		C: out std_logic_vector(3 downto 0);
		D: out std_logic_vector(3 downto 0);
		X: in unsigned(7 downto 0);
		Y: out unsigned(7 downto 0);
		Z: out unsigned(7 downto 0)
-- last port does not need semicolon it will give error if it has	
	);
end; 
/*
types of port mode 
in 
out 
buffer 
inout
*/

/*
types of port types 
bit  -> 1 or 0 
std_logic -> 1 or 0 or u(undefined) or x(unknown) or - (don't care)
std_ulogic

bit_vector(3 downto 0)
std_logic_vector (3 downto 0)
std_ulogic_vector(3 downto 0)

unsigned(3 downto 0)
signed  (3 downto 0)
*/

architecture dataflow of bit_adder is 
signal A_intermediate : boolean;
begin 
	/*
	A,B are inputs 
	C,D are outputs 
	we assign to C using A and B (A and B)
	D <= not C;  Only for buffer as buffer is allowed to be on the right side.
	*/
	Z <= X+Y;
end; 