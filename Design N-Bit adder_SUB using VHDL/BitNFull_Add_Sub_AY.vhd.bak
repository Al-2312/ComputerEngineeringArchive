entity BitNFull_Add_Sub_AY is 
	generic(
	constant N: integer := 4 -- N can now be change was not oringally; 
	);
	port(
			
			A:in std_logic_vector(N-1 downto 0);
			B:in std_logic_vector(N-1 downto 0);
			Cin: in std_logic;
			OP: in std_logic;-- Operational code if 0 do add, if 1 do subtratciton 
			S: out std_logic_vector(N-1 downto 0);
			Cout: out std_logic
			
		);
end;


architecture structural of BitNFull_Add_Sub_AY is
	component Full_Adder_AY is 
		port(
				A:in std_logic;
				B:in std_logic;
				Cin: in std_logic;
				S: out std_logic;
				Cout: out std_logic
		);
	end component;
		signal CarryOuts:std_logic_vector(N downto 0);
begin 
		
		forloop: for i in 0 to N-1 generate  
			fourBit_adder: Full_Adder_AY port map(
						A =>A(i),
						B => B(i) xor OP,
						Cin => CarryOuts(i),
						S => S(i),
						Cout => CarryOuts(i+1)
			);
		end generate forloop;
			CarryOuts(0) <= OP;
			Cout <= CarryOuts(N);
end;