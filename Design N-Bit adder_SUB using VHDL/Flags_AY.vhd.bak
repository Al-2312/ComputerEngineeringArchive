library ieee;
use ieee.std_logic_1164.all;

library work;
use work.Yunayev_Adder_Package.all;

entity Flags_AY is 
port (
        S         : in std_logic_vector(N-1 downto 0);  -- Result of the add/sub operation
        Cin       : in std_logic;                       -- Carry-in for the MSB in add/sub
        Cout      : in std_logic;                       -- Carry-out from the MSB in add/sub
        OVERFLOW  : out std_logic;                      -- Overflow flag
        ZERO      : out std_logic;                      -- Zero flag
        NEGATIVE  : out std_logic                       -- Negative flag
    );
end entity;

architecture Behavioral of Flags_AY is
begin
    OVERFLOW <= Cin xor Cout;
    ZERO <= '1' when S = (others => '0') else '0';
    NEGATIVE <= S(N-1);
end Behavioral;